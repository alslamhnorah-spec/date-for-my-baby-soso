<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Our Little Date ❤️</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    background:
        repeating-linear-gradient(
            90deg,
            #ffffff 0px,
            #ffffff 55px,
            #fff5f6 55px,
            #fff5f6 70px
        );
    color: #8b1725;
    overflow-x: hidden;
}

.page {
    min-height: 100vh;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 30px 18px;
    text-align: center;
    position: relative;
}

.page.active {
    display: flex;
    animation: fadeIn 0.8s ease;
}

.content {
    width: 100%;
    max-width: 500px;
    position: relative;
    z-index: 2;
}

h1 {
    font-size: 38px;
    margin-bottom: 12px;
}

h2 {
    font-size: 30px;
    margin-bottom: 15px;
}

p {
    font-family: Arial, sans-serif;
    line-height: 1.7;
    color: #69212b;
}

.envelope {
    width: 230px;
    height: 155px;
    margin: 25px auto;
    background: #b51f32;
    border-radius: 8px;
    position: relative;
    box-shadow: 0 15px 35px rgba(160, 20, 40, .25);
    cursor: pointer;
}

.envelope:before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    border-left: 115px solid transparent;
    border-right: 115px solid transparent;
    border-top: 85px solid #d94859;
}

.heart {
    position: fixed;
    color: #ffb6c1;
    font-size: 18px;
    animation: floatUp linear infinite;
    opacity: .7;
    pointer-events: none;
}

button {
    border: none;
    padding: 14px 23px;
    border-radius: 30px;
    background: #a9162b;
    color: white;
    font-size: 16px;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(169,22,43,.25);
    transition: .25s;
    margin: 7px;
}

button:hover {
    transform: scale(1.05);
}

button:active {
    transform: scale(.96);
}

.music {
    position: fixed;
    top: 18px;
    right: 18px;
    z-index: 20;
    width: 55px;
    height: 55px;
    border-radius: 50%;
    padding: 0;
    font-size: 23px;
    display: none;
}

.card {
    background: rgba(255,255,255,.9);
    border: 1px solid #ffd2d8;
    border-radius: 22px;
    padding: 22px;
    margin: 14px 0;
    box-shadow: 0 10px 30px rgba(150,20,40,.08);
}

.date-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 22px 0;
}

.date-card {
    background: #fff;
    padding: 18px 10px;
    border-radius: 18px;
    border: 1px solid #ffd0d7;
    font-family: Arial, sans-serif;
}

.flirty {
    font-size: 18px;
    font-weight: bold;
    color: #9b1428;
}

.rule {
    text-align: left;
    margin: 12px 0;
    padding: 15px;
    background: #fff5f6;
    border-radius: 15px;
    font-family: Arial, sans-serif;
}

.yes {
    background: #b3132b;
}

.no {
    background: #777;
    position: relative;
}

.final {
    font-size: 22px;
    font-weight: bold;
}

.hidden {
    display: none;
}

#youtubePlayer {
    position: fixed;
    width: 1px;
    height: 1px;
    left: -10px;
    bottom: -10px;
    opacity: 0;
    pointer-events: none;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(15px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes floatUp {
    from {
        transform: translateY(110vh) rotate(0deg);
    }
    to {
        transform: translateY(-15vh) rotate(360deg);
    }
}

@keyframes pop {
    0% { transform: scale(.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
}
</style>
</head>

<body>

<!-- Floating hearts -->
<script>
for (let i = 0; i < 35; i++) {
    const heart = document.createElement("div");
    heart.className = "heart";
    heart.innerHTML = "♡";
    heart.style.left = Math.random() * 100 + "vw";
    heart.style.animationDuration = (8 + Math.random() * 10) + "s";
    heart.style.animationDelay = Math.random() * 8 + "s";
    heart.style.fontSize = (12 + Math.random() * 18) + "px";
    document.body.appendChild(heart);
}
</script>

<!-- MUSIC BUTTON -->
<button class="music" id="musicBtn" onclick="toggleMusic()">🎵</button>

<!-- YouTube player -->
<div id="youtubePlayer"></div>

<!-- PAGE 1 -->
<section class="page active" id="page1">
    <div class="content">

        <h1>💌</h1>

        <h2>You Have a Special Invitation</h2>

        <p>
            Something special is waiting for you...
        </p>

        <div class="envelope"></div>

        <button onclick="openInvitation()">
            Open Your Invitation 🤍
        </button>

    </div>
</section>


<!-- PAGE 2 -->
<section class="page" id="page2">
    <div class="content">

        <h2>You Are Officially Invited To…</h2>

        <h1>Our Little Date 🖤</h1>

        <p>
            Yes, you.<br>
            The person I'd rather spend my time with. ❤️
        </p>

        <div class="date-grid">

            <div class="date-card">
                <b>Thursday 🤍</b>
            </div>

            <div class="date-card">
                <b>My Home 🏠</b>
            </div>

            <div class="date-card">
                <b>KFC 🍗</b>
            </div>

            <div class="date-card">
                <b>Red ❤️</b>
            </div>

        </div>

        <button onclick="nextPage(3)">
            Continue ❤️
        </button>

    </div>
</section>


<!-- PAGE 3 -->
<section class="page" id="page3">
    <div class="content">

        <h2>First Things First… 🍗❤️</h2>

        <div class="card">

            <h2>KFC DATE 🍗</h2>

            <p>
                We're obviously starting with food.
            </p>

            <p class="flirty">
                Just a little reminder…<br><br>
                You're not only coming to eat KFC.<br>
                You're coming to eat me up too 👅❤️
            </p>

        </div>

        <button onclick="nextPage(4)">
            Keep Going 👀
        </button>

    </div>
</section>


<!-- PAGE 4 -->
<section class="page" id="page4">
    <div class="content">

        <h2>THE DRESS CODE ❤️</h2>

        <div class="card">

            <h1>RED.</h1>

            <p>
                That's the rule.
            </p>

            <p class="flirty">
                I want you wearing red.
                <br><br>
                And yes… even the little secret underneath 👙💋
            </p>

        </div>

        <button onclick="nextPage(5)">
            Okay… 👀
        </button>

    </div>
</section>


<!-- PAGE 5 -->
<section class="page" id="page5">
    <div class="content">

        <h2>Before You Say Yes… 👀</h2>

        <div class="rule">
            ❤️ <b>Rule #1</b><br>
            Come hungry. Very important. 🍗
        </div>

        <div class="rule">
            ❤️ <b>Rule #2</b><br>
            You are required to let me spoil you.
            No arguments.
        </div>

        <div class="rule">
            ❤️ <b>Rule #3</b><br>
            You have to give me attention.
            A lot of it. 😌
        </div>

        <button onclick="nextPage(6)">
            There's Something Else… 👀
        </button>

    </div>
</section>


<!-- PAGE 6 -->
<section class="page" id="page6">
    <div class="content">

        <h2>There's Something Else… 👀</h2>

        <p>
            I saved the most important question for last.
        </p>

        <button onclick="revealQuestion()">
            Reveal the Last Message 💌
        </button>

        <div id="question" class="hidden">

            <h1 style="animation:pop .5s ease">
                Will you be my date? 🥹❤️
            </h1>

            <button class="yes" onclick="sayYes()">
                Yes, Of Course ❤️
            </button>

            <button class="no" id="noBtn" onclick="moveNo()">
                No
            </button>

        </div>

    </div>
</section>


<!-- PAGE 7 -->
<section class="page" id="page7">
    <div class="content">

        <h1>💌❤️✨</h1>

        <h2>DATE CONFIRMED.</h2>

        <p class="final">
            Okay, it's official. 🥹❤️
        </p>

        <p>
            Your Thursday plans are officially booked.
        </p>

        <div class="card">

            <p><b>Thursday 🤍</b></p>
            <p>My Home 🏠</p>
            <p>KFC 🍗</p>
            <p>Red Dress Code ❤️</p>
            <p>Me + You 🖤</p>

        </div>

        <h2>
            See you Thursday, baby soso ❤️
        </h2>

    </div>
</section>


<script>
let currentPage = 1;

function showPage(number) {

    document.querySelectorAll(".page").forEach(page => {
        page.classList.remove("active");
    });

    document.getElementById("page" + number).classList.add("active");

    currentPage = number;

    if (number > 1) {
        document.getElementById("musicBtn").style.display = "block";
    }

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}

function openInvitation() {
    showPage(2);
}

function nextPage(number) {
    showPage(number);
}

function revealQuestion() {
    document.getElementById("question").classList.remove("hidden");
}

function moveNo() {

    const btn = document.getElementById("noBtn");

    const x = Math.random() * 180 - 90;
    const y = Math.random() * 150 - 75;

    btn.style.transform =
        `translate(${x}px, ${y}px)`;
}

function sayYes() {

    showPage(7);

    for (let i = 0; i < 45; i++) {

        const heart = document.createElement("div");

        heart.innerHTML = ["❤️","💗","💕","✨","💖"]
            [Math.floor(Math.random() * 5)];

        heart.style.position = "fixed";
        heart.style.left = "50%";
        heart.style.top = "50%";
        heart.style.fontSize =
            (15 + Math.random() * 25) + "px";

        heart.style.zIndex = "100";
        heart.style.pointerEvents = "none";

        document.body.appendChild(heart);

        const x = (Math.random() - .5) * 500;
        const y = (Math.random() - .5) * 500;

        heart.animate(
            [
                {
                    transform: "translate(-50%,-50%) scale(.3)",
                    opacity: 1
                },
                {
                    transform:
                    `translate(${x}px, ${y}px) scale(1.5)`,
                    opacity: 0
                }
            ],
            {
                duration: 1500,
                easing: "ease-out"
            }
        );

        setTimeout(() => heart.remove(), 1500);
    }
}


/* =========================
   YOUTUBE MUSIC
========================= */

let player;
let musicPlaying = false;

function onYouTubeIframeAPIReady() {

    player = new YT.Player("youtubePlayer", {

        height: "1",
        width: "1",

        videoId: "dL-UJdNSw7U",

        playerVars: {
            autoplay: 0,
            controls: 0,
            loop: 1,
            playlist: "dL-UJdNSw7U",
            playsinline: 1
        },

        events: {
            onReady: function() {}
        }

    });
}

function toggleMusic() {

    if (!player) {
        alert("Please wait a second and try again ❤️");
        return;
    }

    if (!musicPlaying) {

        player.playVideo();

        musicPlaying = true;

        document.getElementById("musicBtn").innerHTML = "🔊";

    } else {

        player.pauseVideo();

        musicPlaying = false;

        document.getElementById("musicBtn").innerHTML = "🎵";
    }
}
</script>

<!-- YouTube API -->
<script src="https://www.youtube.com/iframe_api"></script>

</body>
</html>
